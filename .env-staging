# Metrics Server - Staging Environment Template (Local Simulation)
APP_PROFILE=staging

# Server
PORT=8085
HTTP_PORT=8085
SERVICE_NAME=metrics-gateway
INSTANCE_TOKEN_SECRET=staging-secret-change-me

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=staging_user
DB_PASSWORD=staging_password
DB_NAME=metrics_db
DB_SSLMODE=disable

# NATS
NATS_URL=nats://localhost:4222
NATS_USER=auth-server
NATS_PASSWORD=auth-secret
