# Metrics Server - Production Environment Template
APP_PROFILE=prod

# Server
PORT=8085
HTTP_PORT=8085
SERVICE_NAME=metrics-gateway
INSTANCE_TOKEN_SECRET=prod-secret-must-be-set-via-github-secrets

# Database
DB_HOST=prod-db-hostname
DB_PORT=5432
DB_USER=prod_user
DB_PASSWORD=prod_password
DB_NAME=metrics_db
DB_SSLMODE=require

# NATS
NATS_URL=nats://prod-nats-hostname:4222
NATS_USER=prod_nats_user
NATS_PASSWORD=prod_nats_password
